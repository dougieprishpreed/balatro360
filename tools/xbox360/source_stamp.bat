@echo off
rem Writes the git commit of this source tree to the header given as %1, for
rem the first line of b360.log. Run by Visual Studio before each build of
rem build\xbox360\Balatro360.vcxproj. Without git (e.g. a downloaded zip) the
rem header stays empty and the zip's own stamp is used instead.
setlocal
set "OUT=%~1"
set "TMPF=%~1.tmp"
set "ROOT=%~dp0..\.."
set COMMIT=
set CDATE=
set DIRTY=
for /f %%i in ('git -C "%ROOT%" rev-parse --short HEAD 2^>nul') do set COMMIT=%%i
for /f %%i in ('git -C "%ROOT%" log -1 --format^=%%cI 2^>nul') do set CDATE=%%i
for /f %%i in ('git -C "%ROOT%" status --porcelain --untracked-files^=no 2^>nul') do set DIRTY=+
if not exist "%~dp1" mkdir "%~dp1"
> "%TMPF%" echo // Generated by tools\xbox360\source_stamp.bat
if defined COMMIT >> "%TMPF%" echo #define B360_GIT_COMMIT "%COMMIT%%DIRTY%"
if defined COMMIT >> "%TMPF%" echo #define B360_GIT_DATE "%CDATE%"
rem Only replace the header when it changed, so unchanged builds stay incremental.
fc /b "%TMPF%" "%OUT%" >nul 2>&1
if errorlevel 1 (move /y "%TMPF%" "%OUT%" >nul) else (del "%TMPF%")
exit /b 0
